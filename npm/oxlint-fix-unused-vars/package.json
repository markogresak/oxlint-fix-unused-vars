{
  "name": "oxlint-fix-unused-vars",
  "version": "0.1.4",
  "description": "Autofix no-unused-vars: automatically remove unused variables from TypeScript and JavaScript. The missing fixer for oxlint's (and ESLint's) no-unused-vars rule, written in Rust.",
  "keywords": [
    "no-unused-vars",
    "unused-vars",
    "unused-variables",
    "remove-unused-variables",
    "oxlint",
    "eslint",
    "fix",
    "autofix",
    "fixer",
    "lint",
    "linter",
    "dead-code",
    "codemod",
    "typescript",
    "javascript",
    "oxc",
    "rust"
  ],
  "author": "Marko Gresak <marko@gresak.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markogresak/oxlint-fix-unused-vars.git"
  },
  "homepage": "https://github.com/markogresak/oxlint-fix-unused-vars",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "oxlint-fix-unused-vars",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  }
}
